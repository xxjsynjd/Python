#!/usr/bin/env python3
# ==============================================================================
# 组件名: WMPVisualizer - 切片随机蒙太奇引擎 (完全体)
# 特性: 真实音频 FFT、单插件强制分类校验、随机切片抽帧、FFmpeg 内存混流
# ==============================================================================

import os
import sys
import argparse
import subprocess
import importlib.util
import importlib.machinery
import json
import random
import numpy as np
import pygame

PREFIX = os.environ.get("PREFIX", "/data/data/com.termux/files/usr")
SANDBOX_DIR = os.path.join(PREFIX, "lib", "twmpxpem", "site-packages", "root")

# --- 1. 真实音频解析 (FFT) ---
def get_real_audio_energy(audio_path, start_time, duration, fps=30, sample_rate=44100):
    samples_per_frame = int(sample_rate / fps)
    cmd = ["ffmpeg", "-ss", str(start_time), "-t", str(duration), "-i", audio_path,
           "-f", "s16le", "-ac", "1", "-ar", str(sample_rate), "-"]
    process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    frame_energies = []
    while True:
        raw_data = process.stdout.read(samples_per_frame * 2) 
        if len(raw_data) < samples_per_frame * 2: break
        audio_frame = np.frombuffer(raw_data, dtype=np.int16).astype(np.float32) / 32768.0
        fft_data = np.abs(np.fft.rfft(audio_frame))
        freq_resolution = sample_rate / samples_per_frame
        bass_idx = int(250 / freq_resolution)
        bass_energy = np.mean(fft_data[:bass_idx])
        treble_start = int(4000 / freq_resolution)
        treble_end = min(int(16000 / freq_resolution), len(fft_data))
        treble_energy = np.mean(fft_data[treble_start:treble_end]) if treble_end > treble_start else 0
        frame_energies.append((min(1.0, bass_energy * 0.08), min(1.0, treble_energy * 40.0)))
    process.stdout.close(); process.wait()
    return frame_energies

# --- 2. 扫描与加载插件 (含分类读取) ---
def scan_installed_plugins():
    """扫描所有已安装的插件，并读取其分类信息"""
    plugins = {}
    if not os.path.exists(SANDBOX_DIR): return plugins
    
    for plugin_name in os.listdir(SANDBOX_DIR):
        plugin_path = os.path.join(SANDBOX_DIR, plugin_name)
        toml_path = os.path.join(plugin_path, "twmpxpem-project.toml")
        entry_file = os.path.join(plugin_path, "wmpvisualizer.dll")
        
        if os.path.isdir(plugin_path) and os.path.exists(entry_file):
            # 读取分类信息
            category = "default"
            if os.path.exists(toml_path):
                try:
                    import tomllib
                    with open(toml_path, "rb") as f:
                        config = tomllib.load(f)
                        category = config.get("project", {}).get("category", "default")
                except Exception:
                    pass
            plugins[plugin_name] = {
                "path": entry_file,
                "category": category
            }
    return plugins

def load_plugin_module(plugin_name, entry_path):
    print(f"[*] 正在加载场景引擎: {plugin_name}")
    loader = importlib.machinery.SourceFileLoader(f"root.{plugin_name}", entry_path)
    spec = importlib.util.spec_from_loader(f"root.{plugin_name}", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module

# --- 3. 主程序 ---
def main():
    parser = argparse.ArgumentParser(description="WMPVisualizer - 随机蒙太奇")
    parser.add_argument("-i", "--input", required=True, help="音频文件路径")
    parser.add_argument("-o", "--output", default="output.mp4", help="输出视频路径")
    parser.add_argument("-s", "--scene", help="指定单个插件名称 (必须配合 -p 使用)")
    parser.add_argument("-p", "--profile", help="指定插件分类 (如 video-effects)")
    parser.add_argument("-w", "--width", type=int, default=1280)
    parser.add_argument("-hg", "--height", type=int, default=720)
    parser.add_argument("-fs", "--font-size", type=int, default=36, help="字体大小(备用)")
    parser.add_argument("-d", "--duration", type=float, default=0, help="渲染总时长(秒)，默认0为整首歌")
    args = parser.parse_args()

    pygame.init()
    screen = pygame.Surface((args.width, args.height))

    # 扫描所有插件
    all_plugins = scan_installed_plugins()
    if not all_plugins:
        print("[!] 沙盒里没有发现任何插件。请先使用 twmpxpem install 安装。")
        sys.exit(1)

    # ==========================================
    # 【核心逻辑】强制分类校验与模式选择
    # ==========================================
    if args.scene:
        # 1. 单插件模式：必须指定分类
        if not args.profile:
            print("[!] 错误: 单插件模式 (-s) 必须同时指定插件分类 (-p)。")
            print("[!] 示例: python wmpvisualizer1.py -s edm_glowing_sphere -p video-effects")
            sys.exit(1)
            
        if args.scene not in all_plugins:
            print(f"[!] 找不到插件: {args.scene}")
            sys.exit(1)
            
        actual_category = all_plugins[args.scene]["category"]
        if actual_category != args.profile:
            print(f"[!] 错误: 插件 '{args.scene}' 的分类是 '{actual_category}'，而不是指定的 '{args.profile}'！")
            sys.exit(1)
            
        selected_plugins = {args.scene: all_plugins[args.scene]}
        print(f"[*] 模式: 固定场景 -> {args.scene} (分类: {args.profile})")
        
    elif args.profile:
        # 2. 随机蒙太奇模式：指定了分类，随机抽取该分类下的所有插件
        selected_plugins = {name: info for name, info in all_plugins.items() if info["category"] == args.profile}
        if not selected_plugins:
            print(f"[!] 没有找到属于分类 '{args.profile}' 的插件。")
            sys.exit(1)
        print(f"[*] 模式: 随机蒙太奇 (分类: {args.profile}) -> 找到 {len(selected_plugins)} 个插件")
        
    else:
        # 3. 全库盲盒模式
        selected_plugins = all_plugins
        print(f"[*] 模式: 随机蒙太奇 (全库) -> 找到 {len(selected_plugins)} 个插件")

    # 获取音频总时长
    probe_cmd = ["ffprobe", "-v", "quiet", "-print_format", "json", "-show_format", args.input]
    probe_result = subprocess.run(probe_cmd, capture_output=True, text=True)
    audio_duration = float(json.loads(probe_result.stdout)["format"]["duration"])

    # 计算渲染总时长
    render_duration = args.duration if args.duration > 0 else audio_duration
    render_duration = min(render_duration, audio_duration) # 不能超过原曲时长

    # 设定切片时长
    SEGMENT_DURATION = 5.0
    num_segments = int(render_duration / SEGMENT_DURATION) + (1 if render_duration % SEGMENT_DURATION > 0 else 0)

    print(f"[*] 音频总时长: {audio_duration:.2f} 秒 | 本次渲染: {render_duration:.2f} 秒")
    print(f"[*] 将切分为 {num_segments} 段，每段约 {SEGMENT_DURATION} 秒。")

    # 启动 FFmpeg 混流
    ffmpeg_cmd = [
        "ffmpeg", "-y", "-f", "rawvideo", "-vcodec", "rawvideo",
        "-pix_fmt", "rgb24", "-s", f"{args.width}x{args.height}", "-r", "30",
        "-i", "-", "-i", args.input,
        "-c:v", "libx264", "-preset", "fast", "-crf", "23", "-pix_fmt", "yuv420p",
        "-c:a", "aac", "-b:a", "192k",
        "-map", "0:v:0", "-map", "1:a:0", "-shortest", args.output
    ]
    process = subprocess.Popen(ffmpeg_cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # ==========================================
    # 渲染主循环：按段切片渲染
    # ==========================================
    for seg_idx in range(num_segments):
        seg_start = seg_idx * SEGMENT_DURATION
        seg_end = min(render_duration, seg_start + SEGMENT_DURATION)
        seg_duration = seg_end - seg_start
        
        if seg_duration <= 0: break

        # 1. 随机挑选插件
        plugin_name = random.choice(list(selected_plugins.keys()))
        plugin_info = selected_plugins[plugin_name]
        print(f"\n[*] [第 {seg_idx+1}/{num_segments} 段] {seg_start:.1f}s - {seg_end:.1f}s | 插件: {plugin_name}")
        
        # 2. 动态加载插件
        module = load_plugin_module(plugin_name, plugin_info["path"])
        
        # 3. 解析该段音频
        energies = get_real_audio_energy(args.input, seg_start, seg_duration, fps=30)
        total_frames = len(energies)
        
        # 4. 渲染该段
        for frame_idx in range(total_frames):
            bass, treble = energies[frame_idx]
            screen.fill((15, 15, 25))
            
            spectrum_data = {"bass": bass, "treble": treble}
            dt = 1.0 / 30
            
            # 调用插件契约
            if hasattr(module, 'audio_tick'):
                module.audio_tick(None, spectrum_data, dt)
            if hasattr(module, 'video_render'):
                module.video_render(screen, None, spectrum_data)
            
            frame_data = pygame.image.tostring(screen, "RGB")
            process.stdin.write(frame_data)
            
        print(f"    -> 渲染完毕 (共 {total_frames} 帧)")

    process.stdin.close()
    process.wait()
    pygame.quit()
    print(f"\n[✔] 渲染混流完成！保存为: {args.output}")

if __name__ == "__main__":
    main()
